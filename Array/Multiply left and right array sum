class Solution {
    public int multiply(int[] arr) {
        // code here
        int leftsum=0;
        int rightsum=0;
        int n= arr.length;
        
        for(int i=0 ; i<n/2 ; i++){
             leftsum=leftsum+arr[i];
             
        }
        for(int i=n/2 ; i<n ; i++){
            rightsum=rightsum+arr[i];
        }
        return leftsum*rightsum;
    }
}
