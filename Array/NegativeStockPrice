public class NegativeStockPrice {
    public static void main(String[] args) {
        int[] arr = {10,-30,40,80,90};
        int n= arr.length;

       boolean flag = true;
        for(int i=0 ; i<n ; i++){
            if(arr[i]<0){
                flag = false;;
                System.out.println("Yes negative stock is present "+ arr[i]);
                break;
            }
        }
        if(flag==true){
            System.err.println("negative stock is not present");
        }

    }
}
