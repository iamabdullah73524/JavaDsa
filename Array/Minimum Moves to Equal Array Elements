class Solution {
    public int minMoves(int[] arr) {
        int max=Integer.MIN_VALUE;
        int n=arr.length;

        for(int i=0 ; i<n ; i++){
            if(arr[i]>max){
                max=arr[i];
            }
        }

        int res=0;
       for(int i=0 ; i<n ; i++){
        res=res+(max-arr[i]);
       }
       return res;
    }
}
