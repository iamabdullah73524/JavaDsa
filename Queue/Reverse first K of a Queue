class Solution {
    public Queue<Integer> reverseFirstK(Queue<Integer> q, int k) {
        // code here
        Stack<Integer> st = new Stack<>();
        int n=q.size();
        
         if (k > n) {
            return q;
        }
        //push k ele in stack
        for(int i=0 ; i<k ; i++){
            st.push(q.remove());
        }
        
        //now pop add back to queue
        while(!st.isEmpty()){
            q.add(st.pop());
        }
        
        //now k ke baad wale el ko remove krke add kro
        for(int i=0 ; i<n-k; i++){
            q.add(q.remove());
        }
        
        return q;
        
    }
}
