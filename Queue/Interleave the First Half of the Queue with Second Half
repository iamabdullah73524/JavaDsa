class Solution {
    public void rearrangeQueue(Queue<Integer> q) {
        // code here
        Queue<Integer> firsthalf = new LinkedList<>();
        int n= q.size();
        
        for(int i=0 ; i<n/2 ; i++){
            firsthalf.add(q.remove());
        }
        
        while(!firsthalf.isEmpty()){
            q.add(firsthalf.remove());
            q.add(q.remove());
        }
        
        
    }
}
