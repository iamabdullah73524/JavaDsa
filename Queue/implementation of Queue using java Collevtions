import java.util.*;
public class C {
    //implementation of Queue using java Collevtions
   public static void main(String[] args){
    Queue<Integer> q = new LinkedList<>();
    q.add(1);
    q.add(2);
    System.out.println(q.peek());
    q.remove();
    q.remove();
    System.out.println(q.peek());
   }
}
