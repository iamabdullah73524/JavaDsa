public class MaxEleatRightSide{
    public static void main(String[] args){
        int[] arr = {3,2,1,4,5};
        int n = arr.length;

       
        for(int i=0 ; i<n-1 ; i++){
            int max = Integer.MIN_VALUE;
            int maxindx=-1;
            for(int j=0 ; j<n-i ; j++){
                if(arr[j]>max){
                    max=arr[j];
                    maxindx=j;
                }
            }
            int temp = arr[maxindx];
            arr[maxindx]= arr[n-1-i];
            arr[n-1-i]=temp;
        }

        for(int i=0 ; i<n ; i++){
            System.out.print(arr[i]+" ");
        }

    }
}
