public class SortInDec{
    public static void main(String[] args){
        int[] arr = {3,1,2,4,5};
        int n = arr.length;

        for(int x=0 ; x<n-1 ; x++){
            for(int i=0 ; i<n-1-x ; i++){
                if(arr[i]<arr[i+1]){
                    int temp = arr[i];
                    arr[i]=arr[i+1];
                    arr[i+1]=temp;
                }
            }
        }

        for(int i=0 ; i<n ; i++){
            System.out.print(arr[i]+" ");
        }
        
    }
}
