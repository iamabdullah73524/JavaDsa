public class CountInversion{
    public static void main(String[] args){
        int[] arr = {1,8,5,10,6,2,4};
        int n  = arr.length;
        int si=0;
        int ei=n-1;
        int ans =mergesort(arr,si,ei);
        System.out.print(ans);
    }

    public static int mergesort(int[] arr , int si , int ei){
        if(si>=ei){
            return 0;
        }
        int mid = (si+ei)/2;
        int leftinversion = mergesort(arr,si,mid);
        int rightinversion = mergesort(arr,mid+1,ei);
        int mergeinversion=merge(arr,si,ei,mid);
        return leftinversion+rightinversion+mergeinversion;
    }

    public static int merge(int[] arr, int si, int ei, int mid){
        int n=arr.length;
        int[] temp = new int[ei-si+1];
        int i=si;
        int j=mid+1;
        int k=0;
        int inversion=0;

        while(i<=mid && j<=ei){
            if(arr[i]<arr[j]){
                temp[k++]=arr[i++];
            }
            else{
                temp[k++]=arr[j++];
                inversion=inversion+mid-i+1;
            }
        }

        while(i<=mid){
            temp[k++]=arr[i++];
        }
        while(j<=ei){
            temp[k++]=arr[j++];
        }

        for(int x=0 ; x<temp.length ; x++){
            arr[si+x]=temp[x];
        }
        return inversion;
    }
}
