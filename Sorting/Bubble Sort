class Solution {
    public void bubbleSort(int[] arr) {
        // code here
        int n= arr.length;
        for(int i=0 ; i<n-1 ; i++){ //no of phases = n-1
            for(int j=0 ; j<n-1 ; j++){
                if(arr[j]>arr[j+1]){
                    int temp = arr[j];
                    arr[j]=arr[j+1];
                    arr[j+1]=temp;
                }
            }
        }

//optimize
for(int x=0 ; x<n-1 ; x++){ //n-1 phases
            for(int i=0 ; i<n-1-x ; i++){
                if(arr[i]>arr[i+1]){
                    int temp = arr[i];
                    arr[i]=arr[i+1];
                    arr[i+1]=temp;
                }
            }
            
        }
    }
}
