class Solution {
    public void moveZeroes(int[] nums) {
        int noofzero=0;
        for(int i=0 ; i<nums.length ; i++){
            if(nums[i]==0){
                noofzero++;
            }
        }

        for(int x=0 ; x<noofzero ; x++){
            for(int i=0 ; i<nums.length-1-x ; i++){
                if(nums[i]==0){
                    int temp = nums[i];
                    nums[i]=nums[i+1];
                    nums[i+1]=temp;
                }
            }
        }
    }
}
