class Solution {
	int countTriplets(int target, int arr[]) {
		// code here
		int n = arr.length;
		int count = 0;
		int sum=0;
		Arrays.sort(arr);
		
		for (int i = 0 ; i<n ; i++) {
			int j = i + 1;
			int k = n - 1;
			while(j<k){
			
			sum = arr[i]+arr[j]+arr[k];
			if (sum<target) {
				count = count + (k - j);
				j++;
			}
			else {
				k--;
			}
			}
		}
		return count;
	}
}
