public class SecondLargestDistinctElementinEveryWindow {
    public static void main(String[] args) {
        int[] arr = { 5, 1, 5, 3, 2, 4 };
        int k = 3;
        int n = arr.length;

        for (int i = 0; i <= n - k; i++) {
            int max = arr[i];
            int smax = Integer.MIN_VALUE;
            for (int j = i; j < i + k; j++) {
                if (arr[j] > max) {
                    smax = max;
                    max = arr[j];
                } else if (arr[j] < max && arr[j] > smax) {
                    smax = arr[j];
                }
            }
            System.out.println(smax);
        }

        
    }
}
