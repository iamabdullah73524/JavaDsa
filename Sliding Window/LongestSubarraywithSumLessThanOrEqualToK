public class LongestSubarraywithSumLessThanOrEqualToK {
    public static void main(String[] args) {
        
        int[] arr = {2,1,5,1,3,2};
        int n=arr.length;
        int i=0;
        int j=0;
        int sum=0;
        int maxlen=0;
        int k=7;

        for( i=0 ; i<n ; i++){
            sum=sum+arr[i];

            while(sum>k){
                sum=sum-arr[j];
                j++;
            }

            maxlen = Math.max(maxlen,i-j+1);
        }
        System.out.println(maxlen);
    }
}
