class Solution {
    static List<Integer> firstNegInt(int arr[], int k) {
        // code here
        int n= arr.length;
        ArrayList<Integer> ans = new ArrayList<>();
        
        for(int i=0 ; i<=n-k ; i++){
           boolean flag=false;;
            for(int j=i ; j<i+k ; j++){
                if(arr[j]<0){
                    ans.add(arr[j]);
                    flag=true;
                    break;
                }
            }
            if(!flag){
                ans.add(0);
            }
            
        }
        return ans;
    }
}
