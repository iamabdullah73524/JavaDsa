public class CountWindowsWhoseFirstandLastElementsAreEqual {
    public static void main(String[] args) {
        int[] arr = { 1, 2, 1, 3, 2, 3, 2 };
        int k = 3;
        int n=arr.length;
        int count=0;

        for(int i=0 ; i<=n-k ; i++){
            if(arr[i]==arr[i+k-1]){
                count++;
            }
        }

        System.out.println(count);
    }
}
