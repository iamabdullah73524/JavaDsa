public class MaxProductOfKConsecutiveEl{
    public static void main(String[] args) {
        int[] arr = {1,3,2,5,2,4};
        int n=arr.length;
        int prod =1;
        int k=2;


        for(int i=0 ;i<k ; i++){
            prod=prod*arr[i];
        }
        int max=prod;

        for(int i=0 ; i<n-k ; i++){
            prod=(prod/arr[i])*arr[i+k];
            if(prod>max){
                max=prod;
            }
        }
        System.out.println(max);
    }
}
