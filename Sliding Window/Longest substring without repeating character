class Solution {
    public int lengthOfLongestSubstring(String s) {
        HashSet<Character> set = new HashSet<>();
        int n= s.length();
        int l=0;
        int max=0;
        int left=0;


        for(int i=0 ; i<n ; i++){
            char curr = s.charAt(i);
            while(set.contains(curr)){
                max =Math.max(l,max);
                set.remove(s.charAt(left));
                left++;
                 l=l-1;
            }
            set.add(curr);
            l++;
            max =Math.max(l,max);
        }
        return max;
    }
}
