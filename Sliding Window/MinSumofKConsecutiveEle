public class MinSumofKConsecutiveEle {
    public static void main(String[] args) {
        int[] arr = {1,3,2,6,4};
        int k=2;
        int sum=0;
        int n=arr.length;
    

        for(int i=0 ; i<k ; i++){
            sum=sum+arr[i];
        }
        int min=sum;

        for(int i=0 ; i<n-k ; i++){
            sum=sum-arr[i]+arr[i+k];
            if(sum<min){
                min=sum;
            }
        }
        System.out.println(min);

        
    }
}
