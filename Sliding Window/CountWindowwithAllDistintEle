import java.util.*;

public class CountWindowwithAllDistintEle {
    public static void main(String[] args) {
        int[] arr = { 1, 2, 1, 3, 4, 3 };
        int n = arr.length;
        int ans = 0;
        int k = 3;

        for (int i = 0; i <= n - k; i++) {
            HashSet<Integer> set = new HashSet<>();

            for (int j = i; j < i + k; j++) {
                set.add(arr[j]);
            }
            if (set.size() == k) {
                ans++;
            }
        }

        System.out.println("the no of distint ele window is : " + ans);

    }
}
