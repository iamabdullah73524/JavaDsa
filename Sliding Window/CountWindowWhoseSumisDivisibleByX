public class CountWindowWhoseSumisDivisibleByX {
    public static void main(String[] args){
        int[] arr ={2,1,3,2,4,2};
        int n=arr.length;
        int k=3;
        int x=3;
        int count=0;

        int sum=0;
        for(int i=0 ; i<k ; i++){
            sum=sum+arr[i];
        }
        if(sum%x==0){
            count++;
        }

        for(int i=0 ; i<n-k ; i++){
            sum=sum-arr[i]+arr[i+k];
            if(sum%x==0){
                count++;
            }
        }

        System.out.println(count);
    }
}
