public class CountWindowWhereAllEleArePositive {
    public static void main(String[] args) {
        int[] arr = { 1, 2, -1, 4, 5, 6, -2, 3 };
        int n = arr.length;
        int k = 3;

        int countNeg = 0;
        int ans = 0;

        for (int i = 0; i < k; i++) {
            if (arr[i] < 0) {
                countNeg++;
            }
        }

        if (countNeg == 0) {
            ans++;
        }

        for (int i = 0; i < n - k; i++) {
            if (arr[i] < 0) {
                countNeg--;
            }
            if (arr[i + k] < 0) {
                countNeg++;
            }
            if (countNeg == 0) {
                ans++;
            }
        }

        System.out.println("the number of window whose have all positive ele are : " + ans);

    }
}
