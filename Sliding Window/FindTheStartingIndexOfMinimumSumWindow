public class FindTheStartingIndexOfMinimumSumWindow{
    public static void main(String[] args){
        int[] arr  ={5,2,1,6,3,2,8};
        int n=arr.length;
        int k=3;
        int sum=0;
        int minsum=0;
        int minidx=-1;
        
        for(int i=0 ; i<k ; i++){
            sum=sum+arr[i];
        }
        minsum=sum;
        minidx=0;

        for(int i=0 ; i<n-k ; i++){
            sum=sum-arr[i]+arr[i+k];
            if(sum<minsum){
                minsum=sum;
                minidx=i+1;
            }
        }

        System.out.println(minsum);
        System.out.println(minidx);

    }
}
