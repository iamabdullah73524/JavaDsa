class Solution {
    public int maxVowels(String s, int k) {
        int n= s.length();
        int count=0;
        
        for(int i=0 ; i<k ; i++){
           if(isvowel(s.charAt(i))){
            count++;
           }
        }
        int max=count;


        for(int i=0 ; i<n-k ; i++){
            if(isvowel(s.charAt(i))){
                count--;
            }

            if(isvowel(s.charAt(i+k))){
                count++;
            }

            if(count>max){
                max=count;
            }
        }
        return max;
    }


    public boolean isvowel(char ch){
        if(ch=='a' || ch=='e' || ch=='i' || ch=='o' || ch=='u'){
            return true;
        }
        return false;
    }
}
