public class MaxSumOF2ConsecutiveNum{
    public static void main(String[] args){
        int[] arr = {1,3,2,6,4};
        int k=2;
        int n=arr.length;
        int sum=0;
        int max=Integer.MIN_VALUE;

        for(int i=0 ; i<k ; i++){
            sum=sum+arr[i];
            max=sum;
        }

        //
        for(int i=0 ; i<n-k; i++){
            sum=sum-arr[i]+arr[i+k];
            if(sum>max){
                max=sum;
            }
        }
        System.out.println(max);



    }
}
