class Solution {
    public boolean isSorted(int[] arr) {
        // code here
        // int n=arr.length;
        // boolean flag = true;
        // for(int i=0 ; i<n-1; i++){
        //     if(arr[i]>arr[i+1]){
        //         return false;
        //     }
        // }
        // return flag;
        int i=0;
         return issort(arr,i);
    }
    public static boolean issort(int[] arr, int i){
        if(i==arr.length-1){
            return true;
        }
        else if(arr[i]>arr[i+1]){
            return false;
        }
        i++;
         return issort(arr,i);
    }
}
