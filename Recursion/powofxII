public class powofxII {
    public static void main(String[] args) {
        int x=2;
        int n=3;
        System.out.println(pow(2,3)); 
    }
    public static int pow(int x,int n){
        if(n==0){
            return 1;
        }
        int xn = pow(x,n/2)*pow(x,n/2);
        if(n%2!=0){
            xn= xn*x;
        }
        return xn;
    }
}
