public class GooglyPrimeNo{
    public static void main(String[] args){
        int n= 36;
        int sum=0;
        while(n>0){
            int ld = n%10;
            sum=sum+ld;
            n=n/10;
        }
        if(isPrime(sum)){
            System.out.println("Num is googly prime");
        }else{
            System.out.println("Num is not googly prime");
        }

    }

    public static boolean isPrime(int n){
        if(n<=1){
            return false;
        }
        for(int i=2; i<=n/2 ; i++){
            if(n%i== 0){
                return false;
            }
        }
        return true;
    }
}
