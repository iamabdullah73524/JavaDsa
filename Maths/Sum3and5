import java.util.*;
public class Sum{
   
    public static void  main(String[] args){
        int m = 10;
        int n= 30;
        ArrayList<Integer> ans = fn(m,n);

        for(int i=0; i<ans.size(); i++){
            System.out.println(ans.get(i));
        }

    }

    public static ArrayList<Integer> fn(int m , int n){
        ArrayList<Integer> ans = new ArrayList<>();

        for(int i=m ; i<=n ; i++){
            if(i%3==0 && i%5==0){
                ans.add(i);
            }
        }
        return ans;
    }
}
