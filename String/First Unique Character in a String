		// 	if (map.get(ch) == 1) {
		// 		return i;
		// 	}
		// }
		
		// return -1;
        int n= s.length();

        int[] freq = new int[26];
        Queue<Integer> q = new LinkedList<>();

        for(int i=0; i<n ; i++){
            char ch = s.charAt(i);
            q.add(i);
            freq[ch-'a']++;
        }

        while(!q.isEmpty() && freq[s.charAt(q.peek())-'a']>1){
            q.remove();
        }

        if(q.isEmpty()){
            return -1;
        }
        else{
            return q.peek();
        }
    }
}
