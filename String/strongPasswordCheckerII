class Solution {
    public boolean strongPasswordCheckerII(String s) {
        int n = s.length();
        if(n<8){
            return false;
        }
        boolean lowercase=false;
        boolean uppercase = false;
        boolean digit = false;
        boolean special = false;

    for (int i = 1; i < s.length(); i++) {
    if (s.charAt(i) == s.charAt(i - 1)) {
        return false;
    }
}

        for(int i=0 ; i<n ; i++){
            //consecutive check
            char curr = s.charAt(i);
            if(Character.isUpperCase(curr)){
                uppercase = true;
            }
            else if(Character.isLowerCase(curr)){
                lowercase= true;
            }
            else if(Character.isDigit(curr)){
                digit = true;
            }
            else if(curr=='!' || curr == '@' || curr == '#' || curr == '$' || curr== '%' || curr == '^' || curr == '&' || curr=='*' || curr =='(' || curr== ')' || curr == '-' || curr == '+'){
                special=true;
            }
        }

        if(lowercase && uppercase && digit && special ){
            return true;
        }

        return false;
    }
}
