class Solution {
    public String longestCommonPrefix(String[] strs) {
       int n=strs.length;
       Arrays.sort(strs);
       StringBuilder sb = new StringBuilder();

       int l = Math.min(strs[0].length(), strs[n - 1].length());

       for(int i=0 ; i<l ; i++){
        if(strs[0].charAt(i) == strs[n-1].charAt(i)){
            sb.append(strs[0].charAt(i));
        }
        else{
            return sb.toString();
        }
       }
       return sb.toString();
    }
}
