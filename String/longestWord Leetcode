class Solution {
    public String longestWord(String[] words) {
        int n = words.length;
        HashSet<String> set = new HashSet<>();
        for (int i = 0; i < n; i++) {
            set.add(words[i]);
        }

        String ans = "";
        for (int i = 0; i < n; i++) {
            boolean valid = true;
            String curr = words[i];
            for (int j = 1; j <= curr.length(); j++) {
                if (!set.contains(curr.substring(0, j))) {
                    valid = false;
                    break;
                }
            }

            if (valid) {
                if (curr.length() > ans.length() || (curr.length() == ans.length() && curr.compareTo(ans) < 0)) {
                    ans = curr;
                }
            }
        }
        return ans;
    }
}
