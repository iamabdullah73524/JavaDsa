class Solution {
    public String truncateSentence(String s, int k) {
        StringBuilder sb = new StringBuilder("");
        String word[] = s.split(" ");

        if(k<1){
            return sb.toString();
        }

        for(int i=0 ; i<k ; i++){
            sb.append(word[i]);
             if (i < k - 1) {
                sb.append(" ");
            }
        }
        return sb.toString();
    }
}
