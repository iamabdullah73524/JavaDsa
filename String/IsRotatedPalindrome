class Solution {
    boolean isRotatedPalindrome(String s) {
        // code here
        int n=s.length();
        
        for(int i=0 ; i<n ; i++){
            if(isPalindrome(s)){
                return true;
            }
           s = s.substring(1) + s.charAt(0);
        }
        return false;
    }
    
    public static boolean isPalindrome(String s){
        int left=0;
        int right=s.length()-1;
        
        while(left<right){
            if(s.charAt(left)!=s.charAt(right)){
                return false;
            }
            left++;
            right--;
        }
        return true;
    }
}
