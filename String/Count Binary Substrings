class Solution {
    public int countBinarySubstrings(String s) {
     int n= s.length();
      int curr=1;
      int prev=0;
      int ans=0;

      for(int i=1 ; i<n ; i++){
        if(s.charAt(i)==s.charAt(i-1)){
            curr++;
        }
        else{
            prev=curr;
            curr=1;
        }
        if(curr<=prev){
            ans++;
        }
      }

      return ans;
    }
}
