class Solution {
	public int evaluatePostfix(String[] arr) {
		// code here
		int n = arr.length;
		Stack<Integer> st = new Stack<>();
		
		for (String s : arr) {
			if (s.equals("+")) {
				int b = st.pop();
				int a = st.pop();
				st.push(a + b);
			}
			else if (s.equals("-")) {
				int b = st.pop();
				int a = st.pop();
				st.push(a - b);
			}
			else if (s.equals("*")) {
				int b = st.pop();
				int a = st.pop();
				st.push(a*b);
			}
			else if (s.equals("/")) {
				int b = st.pop();
				int a = st.pop();
				st.push(Math.floorDiv(a, b));
			}
			else if (s.equals("^")) {
				int b = st.pop();
				int a = st.pop();
				st.push((int)Math.pow(a, b));
			}
			else {
				st.push((Integer.parseInt(s)));
			}
		}
		return st.pop();
	}
}
