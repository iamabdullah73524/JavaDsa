class Solution {
    public String removeKdigits(String num, int k) {
        int n= num.length();
        Stack<Character> st = new Stack<>();
        StringBuilder sb = new StringBuilder();

        for(int i=0 ; i<n ; i++){
            char curr =num.charAt(i);
            while( !st.isEmpty() && curr<st.peek() && k>0){
                st.pop();
                k=k-1;
            }
            st.push(curr);
        }
         while (k > 0) {
            st.pop();
            k--;
        }

        while(!st.isEmpty()){
            sb.append(st.pop());
        }

        sb.reverse();

         while (sb.length() > 0 && sb.charAt(0) == '0') {
            sb.deleteCharAt(0);
        }

        if (sb.length() == 0) {
            return "0";
        }

        return sb.toString();
    }
}
