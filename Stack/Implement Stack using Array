public class A{
    //implement stack using array
    static class Stack{
        int[] arr;
        int top;
        Stack(int size){
            arr = new int[size];
                top = -1;
        }

        void push(int x){
            if(top==arr.length-1){
                System.out.print("Stack is overflow");
                return;
            }
            top++;
            arr[top]=x;
        }

        int peek(){
            if(top==-1){
                System.out.print("Stack is Empty");
                return -1;
            }
            return arr[top];
        }

        int pop(){
            if(top==-1){
                System.out.println("Stack is Empty it can not be pop");
                return -1;
            }
            return arr[top--];
        }
    }




    public static void main(String[] args){
        Stack st = new Stack(5);
        st.push(1);
        st.push(2);
        System.out.println(st.peek());
        System.out.println(st.pop());
        System.out.println(st.peek());

    }
}
