class Solution {
    public static void reverseStack(Stack<Integer> st) {
        // code here
        if(st.isEmpty()){
            return;
        }
        int top  = st.pop();
        reverseStack(st);
        pushatbtm(st,top);
    }
    public static void pushatbtm(Stack<Integer> st , int data){
        if(st.isEmpty()){
            st.push(data);
            return;
        }
        int top = st.pop();
        pushatbtm(st,data);
        st.push(top);
    }
}
