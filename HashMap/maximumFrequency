class Solution {
    public String maximumFrequency(String s) {
        // Code here
        String[] arr = s.split(" ");
        HashMap<String,Integer> map= new HashMap<>();
        int n= arr.length;
        
        for(int i=0 ; i<n ; i++){
            String curr = arr[i];
            if(map.containsKey(curr)){
                map.put(curr,map.get(curr)+1);
            }
            else{
                map.put(curr,1);
            }
        }
        
        int max=0;
        String ans="";
        
        for(int i=0 ; i<n ; i++){
            if(map.get(arr[i])>max){
                max=map.get(arr[i]);
                ans=arr[i];
            }
        }
        
        return ans+" "+max ;
        
        
    }
}
