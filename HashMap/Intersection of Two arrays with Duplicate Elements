class Solution {
    public ArrayList<Integer> intersect(int[] a, int[] b) {
        // code here
        HashSet<Integer> set = new HashSet<>();
        ArrayList<Integer> ans = new ArrayList<>();
        
        for(int i=0 ; i<a.length; i++){
            set.add(a[i]);
        }
        
        for(int i=0 ; i<b.length ; i++){
            if(set.contains(b[i])){
                ans.add(b[i]);
                set.remove(b[i]);
            }
        }
        
        return ans;
    }
}
