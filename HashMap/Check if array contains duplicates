class Solution {
    public boolean checkDuplicates(int arr[]) {
        // Code here
        HashMap<Integer,Integer> map = new HashMap<>();
        int n= arr.length;
        
        for(int i=0 ; i<n ; i++){
            int curr = arr[i];
            if(map.containsKey(curr)){
                map.put(curr,map.get(curr)+1);
            }
            else{
                map.put(curr,1);
            }
        }
        
        for(int i=0 ;i<n ; i++){
            if(map.get(arr[i])>1){
                return true;
            }
        }
        
        return false;
    }
}
