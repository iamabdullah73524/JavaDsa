class Solution {
	public static int countSetBits(int n) {
		// code here
	int total=0;
	
	for(int i=0 ; (1 << i) <=n ; i++){
	   
	   int cycle = 1<<(i+1);
	   int half = 1<<i;
	   
	   int fullcycle = (n+1)/cycle;
	   int reminder = (n+1)%cycle;
	   
	   total=total+fullcycle*half;
	   total=total+Math.max(0,reminder-half);
	   
	 }
	 
	 return total;
	}
	
}
