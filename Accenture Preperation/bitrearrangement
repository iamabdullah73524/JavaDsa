import java.util.*;
public class bitrearrangement {
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int ans =fn(n);
        System.out.println(ans);
    }

    public static int fn(int n){
        int count=0;
        while(n>0){
            if((n&1)==1){
                count++;
            }
            n=n/2;
        }
        return (1<<count)-1;
    }
}
