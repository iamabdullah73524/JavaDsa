import java.util.*;
public class LargeSmallSum{
    public static void main(String[] args){
       int[] arr = {3, 2, 1, 7, 5, 4};
        int n = arr.length;

        ArrayList<Integer> odd = new ArrayList<>();
        ArrayList<Integer> even = new ArrayList<>();

        for(int i=0 ; i<n ; i++){
            if(i%2!=0){
                odd.add(arr[i]);
            }
            else{
                even.add(arr[i]);
            }
        }

        Collections.sort(even);
        Collections.sort(odd);
        int seclarg = even.get(even.size()-2);
        int secsmall = odd.get(1);

        System.out.println(seclarg+secsmall);
    }
}
