import java.util.*;

public class MergeSortedArrays {
    public static void main(String[] args) {
        int[] arr1 = { 1, 2, 3, 4, 5 };
        int n1 = arr1.length;

        int[] arr2 = { 2, 4, 6, 8, 10 };
        int n2 = arr2.length;

        int[] temp = new int[n1 + n2];
        int i = 0, j = 0, k = 0;

        while (i < n1 && j < n2) {
            if (arr1[i] < arr2[j]) {
                temp[k++] = arr1[i++];
            } else {
                temp[k++] = arr2[j++];
            }
        }

        while(i<n1){
            temp[k++]=arr1[i++];
        }

        while(j<n2){
            temp[k++]=arr2[j++];
        }

        System.out.println("Merged array:");
        for (int l = 0; l < temp.length; l++) {
            System.out.print(temp[l] + " ");
        }
    }
}
